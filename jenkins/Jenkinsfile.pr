pipeline {
  agent any
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }
    stage('Setup') {
      steps {
        bat 'echo "Setup: node version"; node -v || true'
      }
    }
    stage('Build') {
      steps {
        bat 'docker build -t devops-todo:pr -f Dockerfile .'
      }
    }
    stage('Run (Docker)') {
      steps {
        bat '''
          docker rm -f devops-todo-pr || true
          docker run -d --name devops-todo-pr -p 3001:3000 devops-todo:pr
        '''
      }
      post {
        always {
          bat 'sleep 2'
        }
      }
    }
    stage('Smoke Test') {
      steps {
        bat './scripts/smoke.sh http://localhost:3001'
      }
    }
    stage('Archive Artifacts') {
      steps {
        bat 'echo "Archiving logs and smoke result" > smoke_result.txt || true'
        archiveArtifacts artifacts: 'smoke_result.txt', fingerprint: true
      }
    }
  }
  post {
    always {
      bat 'docker rm -f devops-todo-pr || true'
    }
  }
}
